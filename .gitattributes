# Python and web source use LF on both platforms; Windows launchers keep CRLF.
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.vbs text eol=crlf
